# Copy to your shell profile or local secret manager. Do not commit real keys.
DEEPSEEK_API_KEY="replace-with-your-key"
WORK_AGENT_MODEL_PROFILE="deepseek-v4-pro"
WORK_AGENT_ADMIN_USERNAME="admin"
# Use a unique password with at least 8 characters. This is required on a new installation.
WORK_AGENT_ADMIN_PASSWORD="replace-with-a-strong-password"
# Required for creating member accounts. If omitted, new-user registration is disabled.
WORK_AGENT_INVITE_CODE="replace-with-a-long-random-invite-code"

# Historical chat RAG can use an in-process BGE-M3 MLX 6-bit model.
# Keep it disabled until a local model has been downloaded and the path below
# points to that directory. It loads lazily on the first semantic history search.
WORK_AGENT_HISTORY_RAG_ENABLED="0"
WORK_AGENT_HISTORY_MLX_MODEL_PATH="/absolute/path/to/bge-m3-6bit"
WORK_AGENT_HISTORY_EMBEDDING_MODEL="bge-m3-mlx-6bit"
WORK_AGENT_HISTORY_MLX_MAX_LENGTH="512"
WORK_AGENT_HISTORY_MLX_BATCH_SIZE="8"

# 记忆检索（RAG）走硅基流动云端：embedding 与 rerank 都不需要本地显卡。
# 密钥只从环境读，源码里没有默认值——本仓库是公开的。
SILICONFLOW_API_KEY="replace-with-your-key"
# 以下三项都有默认值，只在换端点或换模型时才需要设置。
# RECALL_EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"
# RECALL_EMBEDDING_MODEL="Pro/BAAI/bge-m3"
# RECALL_RERANK_MODEL="BAAI/bge-reranker-v2-m3"

# 小红书 Dots（当前免费）。认证头是 api-key，不是 Authorization: Bearer。
DOTS_API_KEY="replace-with-your-key"

# 商汤 SenseNova（免费额度）：sensenova-6.8-flash-lite / deepseek-v4-flash / glm-5.2
SENSENOVA_API_KEY="replace-with-your-key"
