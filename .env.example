# Copy to your shell profile or local secret manager. Do not commit real keys.
DEEPSEEK_API_KEY="replace-with-your-key"
WORK_AGENT_MODEL_PROFILE="deepseek-v4-pro"
WORK_AGENT_ADMIN_USERNAME="admin"
# Use a unique password with at least 8 characters. This is required on a new installation.
WORK_AGENT_ADMIN_PASSWORD="replace-with-a-strong-password"

# Historical chat RAG uses an in-process BGE-M3 MLX 6-bit model.
# It loads lazily on the first historical semantic search.
WORK_AGENT_HISTORY_RAG_ENABLED="1"
WORK_AGENT_HISTORY_MLX_MODEL_PATH="/Users/alian/llm_model/mlx/bge-m3-6bit"
WORK_AGENT_HISTORY_EMBEDDING_MODEL="bge-m3-mlx-6bit"
WORK_AGENT_HISTORY_MLX_MAX_LENGTH="512"
WORK_AGENT_HISTORY_MLX_BATCH_SIZE="8"
