<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.work-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>__WORKSPACE_ROOT__/scripts/work_agent_service.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__WORKSPACE_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__WORKSPACE_ROOT__/tmp/work_agent-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__WORKSPACE_ROOT__/tmp/work_agent-launchd.err.log</string>
</dict>
</plist>
